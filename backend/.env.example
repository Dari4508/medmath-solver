# Copy to .env and adjust for your environment.
# All values have safe defaults for local dev.

APP_ENV=dev
APP_VERSION=1.1.0
DEFAULT_LANG=es

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production

DATABASE_URL=sqlite:///./medmath.db

# Comma-separated CORS origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# slowapi storage (memory:// for single process, redis:// for multi-worker)
RATE_LIMIT_STORAGE=memory://
RATE_LIMIT=30/minute

# Tolerance for expected vs computed solution comparison
EXPECTED_TOLERANCE=1e-6
